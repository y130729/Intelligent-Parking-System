.overview-band {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(16, 24, 40, 0.06);
}

.overview-main {
  flex: 1;
  min-width: 0;
}

.cloud-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #667085;
  font-size: 24rpx;
  margin-bottom: 18rpx;
}

.parking-name {
  display: block;
  color: #101828;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
}

.parking-address {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.5;
}

.refresh-button {
  width: 120rpx;
  min-height: 68rpx;
  color: #0f6848;
  background: #e8f6ef;
  font-size: 26rpx;
  font-weight: 700;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.metric-cell {
  min-height: 148rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.metric-cell.highlight {
  color: #ffffff;
  background: #0f8a5f;
}

.metric-label {
  color: #667085;
  font-size: 24rpx;
}

.metric-cell.highlight .metric-label {
  color: rgba(255, 255, 255, 0.78);
}

.metric-value {
  color: #101828;
  font-size: 44rpx;
  font-weight: 800;
}

.metric-cell.highlight .metric-value {
  color: #ffffff;
}

.notice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-left: 8rpx solid #d98b17;
  border-radius: 8rpx;
  background: #fff8eb;
}

.notice-title,
.notice-text,
.notice-time {
  display: block;
}

.notice-title {
  color: #8a5a0f;
  font-size: 24rpx;
  font-weight: 700;
}

.notice-text {
  margin-top: 8rpx;
  color: #3f2f12;
  font-size: 28rpx;
  line-height: 1.45;
}

.notice-time {
  flex-shrink: 0;
  color: #8a5a0f;
  font-size: 23rpx;
}

.legend {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.filter-tab {
  min-height: 68rpx;
  color: #475467;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.filter-tab.active {
  color: #0f6848;
  background: #dff3ea;
}

.spot-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14rpx;
}

.spot-cell {
  height: 112rpx;
  padding: 14rpx 8rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spot-cell.empty {
  border-color: #9ee4c4;
  background: #e8f8f0;
}

.spot-cell.occupied {
  border-color: #f0a8ab;
  background: #fff0f0;
}

.spot-id {
  color: #101828;
  font-size: 25rpx;
  font-weight: 800;
}

.spot-status {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.fee-band {
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.fee-title,
.fee-text {
  display: block;
}

.fee-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.fee-text {
  margin-top: 10rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.5;
}

@media (max-width: 340px) {
  .spot-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .metric-grid {
    grid-template-columns: 1fr;
  }
}
