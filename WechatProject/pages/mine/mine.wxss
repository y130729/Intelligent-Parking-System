.profile-panel {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(16, 24, 40, 0.06);
}

.avatar-button {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  border-radius: 8rpx;
  overflow: hidden;
  background: #eef2f6;
  align-self: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  display: block;
}

.profile-main {
  width: 100%;
}

.profile-label {
  display: block;
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 25rpx;
  font-weight: 700;
}

.nickname-input {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
  color: #101828;
  font-size: 28rpx;
  font-weight: 600;
}

.role-text {
  display: block;
  width: 100%;
  margin-top: 14rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.4;
  text-align: center;
  white-space: normal;
}

.save-profile {
  width: 100%;
  min-height: 72rpx;
  font-size: 27rpx;
}

.form-panel {
  padding: 30rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  color: #344054;
  font-size: 25rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
  color: #101828;
  font-size: 28rpx;
}

.notify-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
}

.notify-title {
  display: block;
  color: #344054;
  font-size: 25rpx;
  font-weight: 700;
}

.notify-desc {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.4;
}

.notify-status {
  min-width: 108rpx;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  color: #8a5a00;
  background: #fff4d6;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.notify-status.enabled {
  color: #0f6848;
  background: #e8f6ef;
}

.notice-button {
  width: 100%;
  margin-top: 24rpx;
}

.feedback-input {
  width: 100%;
  min-height: 190rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
  color: #101828;
  font-size: 28rpx;
  line-height: 1.5;
}

.form-button {
  margin-top: 24rpx;
}
