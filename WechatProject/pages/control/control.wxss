.control-hero {
  padding: 34rpx 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(16, 24, 40, 0.06);
}

.cloud-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #667085;
  font-size: 24rpx;
  margin-bottom: 18rpx;
}

.hero-title,
.hero-copy {
  display: block;
}

.hero-title {
  color: #101828;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-copy {
  margin-top: 12rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.5;
}

.command-panel {
  padding: 30rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.command-state {
  min-height: 150rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #f2f4f7;
}

.command-state.pending {
  background: #fff8eb;
}

.command-state.success {
  background: #e8f8f0;
}

.command-state.failed {
  background: #fff0f0;
}

.command-title,
.command-message {
  display: block;
}

.command-title {
  color: #101828;
  font-size: 34rpx;
  font-weight: 800;
}

.command-message {
  margin-top: 12rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.5;
}

.open-button {
  min-height: 104rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #0f8a5f;
  font-size: 34rpx;
  font-weight: 800;
  border-radius: 8rpx;
}

.small-button {
  width: 108rpx;
  min-height: 60rpx;
  font-size: 24rpx;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 136rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-action,
.log-message,
.log-meta {
  display: block;
}

.log-action {
  color: #101828;
  font-size: 29rpx;
  font-weight: 700;
}

.log-message {
  margin-top: 8rpx;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.4;
}

.log-meta {
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 23rpx;
}

.log-result {
  flex-shrink: 0;
  min-width: 76rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.log-result.success {
  color: #0f6848;
  background: #dff3ea;
}

.log-result.failed {
  color: #b42318;
  background: #fee4e2;
}
