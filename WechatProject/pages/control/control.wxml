<view class="page-shell">
  <view class="control-hero">
    <view>
      <view class="cloud-row">
        <view class="status-dot {{connectionClass}}"></view>
        <text>{{connectionText}}</text>
      </view>
      <text class="hero-title">入口道闸</text>
      <text class="hero-copy">远程抬杆指令将通过云平台下发到网关设备</text>
    </view>
  </view>

  <view class="section command-panel">
    <view class="command-state {{lastResponse.state}}">
      <text class="command-title">{{lastResponse.title}}</text>
      <text class="command-message">{{lastResponse.message}}</text>
    </view>
    <button class="open-button" loading="{{isOpening}}" bindtap="openBarrier">远程开闸</button>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">操作记录</text>
      <button class="ghost-button small-button" bindtap="loadLogs">刷新</button>
    </view>
    <view class="log-list">
      <view wx:for="{{logs}}" wx:key="id" class="log-item">
        <view class="log-main">
          <text class="log-action">{{item.action}}</text>
          <text class="log-message">{{item.message}}</text>
          <text class="log-meta">{{item.operator}} · {{item.timeText}}</text>
        </view>
        <text class="log-result {{item.resultClass}}">{{item.resultText}}</text>
      </view>
    </view>
  </view>
</view>
