/**app.wxss**/
page {
  min-height: 100vh;
  background: #f5f7f6;
  color: #1d2939;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  background: #f5f7f6;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  color: #101828;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #667085;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.status-dot.empty {
  background: #16a06b;
}

.status-dot.occupied {
  background: #e5484d;
}

.status-dot.pending {
  background: #d98b17;
}

.primary-button {
  min-height: 88rpx;
  padding: 0 28rpx;
  color: #ffffff;
  background: #0f8a5f;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-button {
  min-height: 72rpx;
  padding: 0 24rpx;
  color: #0f6848;
  background: #e8f6ef;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
